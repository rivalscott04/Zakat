APP_NAME="ZETRA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zakat_os
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dibiarkan null supaya cookie sesi bersifat host-only.
# Kalau diisi "localhost", cookie tidak akan terkirim saat aplikasi dibuka lewat
# 127.0.0.1 (dan sebaliknya), karena browser memperlakukan keduanya sebagai host
# berbeda. Akibatnya login berhasil tetapi request berikutnya kembali 401.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bootstrap instalasi pertama (php artisan db:seed --class=Database\\Seeders\\BootstrapSeeder)
ZAKAT_BOOTSTRAP_ORG_CODE=ZETRA
ZAKAT_BOOTSTRAP_ORG_NAME=ZETRA
ZAKAT_BOOTSTRAP_EMAIL=admin@zakat.test
ZAKAT_BOOTSTRAP_USERNAME=superadmin
ZAKAT_BOOTSTRAP_PASSWORD=
