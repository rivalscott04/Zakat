{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "baseUrl": "./src",
    "paths": {
      "@app/*": ["app/*"],
      "@features/*": ["features/*"],
      "@shared/*": ["shared/*"],
      "@template/*": ["template/*"],
      "pages/*": ["template/pages/*"],
      "common/data/*": ["template/data/*"],
      "Components/*": ["shared/components/*"],
      "Layouts/*": ["shared/layouts/*"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/index.tsx",
    "src/app/App.tsx",
    "src/app/routes/index.tsx",
    "src/app/routes/AuthProtected.tsx",
    "src/app/routes/allRoutes.tsx",
    "src/features/api",
    "src/features/auth/AuthProvider.tsx",
    "src/features/auth/guards.tsx",
    "src/features/auth/pages/Login.tsx",
    "src/features/auth/pages/AuthShell.tsx",
    "src/features/auth/pages/ParticlesAuth.tsx",
    "src/features/components/DataTable.tsx",
    "src/features/components/StatusBadge.tsx",
    "src/features/hooks/usePagedResource.ts",
    "src/features/layout",
    "src/features/muzakis",
    "src/shared/config",
    "src/shared/components/Common/BreadCrumb.tsx",
    "src/i18n.ts",
    "vite.config.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "backend",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/setupTests.ts"
  ]
}
